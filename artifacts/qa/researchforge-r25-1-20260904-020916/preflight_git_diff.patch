+export interface QualityRetryAttemptAudit {
+  attempt: number;
+  retryStage: QualityRetryStage | "limited_evidence_downgrade";
+  dimensions: ReportQualityDimension[];
+  failureLocations: string[];
+  beforePassed: boolean;
+  afterPassed: boolean;
+  changed: boolean;
