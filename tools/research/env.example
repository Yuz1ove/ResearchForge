# Core academic APIs
ENABLE_OPENALEX=true
ENABLE_CROSSREF=true
ENABLE_SEMANTIC_SCHOLAR=true
ENABLE_ARXIV=true
ENABLE_DOAJ=false
ENABLE_CORE=false
ENABLE_UNPAYWALL=false

SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
UNPAYWALL_EMAIL=

# PDF tools
ENABLE_GROBID=true
GROBID_URL=http://localhost:8070

ENABLE_TIKA=true
TIKA_URL=http://localhost:9998

ENABLE_PYMUPDF=true
ENABLE_PDFMINER=true
ENABLE_PDFPLUMBER=true

# OCR tools
ENABLE_TESSERACT=false
ENABLE_PADDLEOCR=false

# Experimental parsers
ENABLE_UNSTRUCTURED=false
ENABLE_DOCLING=false
ENABLE_MARKER=false
ENABLE_MINERU=false

# Web extraction
ENABLE_WEB_EXTRACTION=false
ENABLE_SCRAPY=false
ENABLE_PLAYWRIGHT=false
ENABLE_CRAWL4AI=false
ENABLE_TRAFILATURA=false

# Vector / language
ENABLE_FASTTEXT_LANGID=false
FASTTEXT_LID_MODEL_PATH=

ENABLE_MULTILINGUAL_E5=false
E5_MODEL_NAME=intfloat/multilingual-e5-small

ENABLE_PGVECTOR=false
ENABLE_QDRANT=false
QDRANT_URL=http://localhost:6333

# Safety
ALLOW_PUBLIC_WEB_EXTRACTION_ONLY=true
ALLOW_PAYWALL_BYPASS=false
ALLOW_GOOGLE_SCHOLAR_SCRAPING=false

# Workflow
ENABLE_WORKFLOW_ISOLATION=true
ENABLE_RESEARCH_DEBUG=false
